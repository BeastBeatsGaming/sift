{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sift",
  "version": "0.2.0",
  "identifier": "dev.saimayank.sift",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sift",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Sai Mayank",
    "shortDescription": "Disk analyzer and cleanup",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}